{
  "name": "infos-ts",
  "productName": "萌动链接：PeroperoChat！",
  "private": true,
  "version": "0.9.6",
  "description": "infOS-TS — 萌动链接：PeroperoChat！的 TypeScript 全栈引擎",
  "main": "dist-electron/main/index.js",
  "author": "YoKONCy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoKONCy/infOS.git"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "version:sync": "tsx scripts/sync-version.ts",
    "dev": "pnpm --filter @infos/backend dev",
    "dev:daemon": "pnpm --filter @infos/daemon dev",
    "dev:frontend": "pnpm --filter @infos/frontend dev",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start": "node scripts/start-dev.mjs",
    "build": "pnpm -r --filter \"*\" run build && electron-vite build --config electron.vite.config.ts",
    "clean": "pnpm -r run clean",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:shared": "vitest run packages/shared/tests packages/shared/src",
    "test:backend": "vitest run packages/backend/tests packages/backend/src",
    "test:frontend": "vitest run packages/frontend/tests packages/frontend/src",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,vue,css,json}\"",
    "typecheck": "pnpm -r run typecheck",
    "docker:build": "docker compose build",
    "docker:validate": "docker compose config --quiet",
    "docker:smoke": "node scripts/docker-runtime-smoke.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop infos-backend",
    "pm2:restart": "pm2 restart infos-backend",
    "pm2:logs": "pm2 logs infos-backend",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "changeset version && pnpm version:sync && pnpm build && changeset publish",
    "build:official-apps": "node scripts/build-official-apps.mjs",
    "electron:build": "pnpm electron:build:standard",
    "electron:build:steam": "pnpm security:runtime && pnpm security:electron && cross-env INFOS_EDITION=steam pnpm version:sync && pnpm build && pnpm build:official-apps && node scripts/build-daemon-bundle.mjs && node scripts/collect-daemon-deps.mjs && pnpm rebuild:daemon-deps && electron-builder --config electron-builder.steam.yml",
    "electron:build:standard": "pnpm security:runtime && pnpm security:electron && pnpm version:sync && pnpm build && pnpm build:official-apps && node scripts/build-daemon-bundle.mjs && node scripts/collect-daemon-deps.mjs && pnpm rebuild:daemon-deps && electron-builder --config electron-builder.standard.yml",
    "electron:build:portable": "pnpm security:runtime && pnpm security:electron && cross-env INFOS_EDITION=portable pnpm version:sync && pnpm build && pnpm build:official-apps && node scripts/build-daemon-bundle.mjs && node scripts/collect-daemon-deps.mjs && pnpm rebuild:daemon-deps && electron-builder --config electron-builder.portable.yml",
    "rebuild:daemon-deps": "node scripts/rebuild-daemon-deps.mjs",
    "security:runtime": "node scripts/runtime-security.cjs --node --configuration",
    "security:electron": "node scripts/runtime-security.cjs --configuration --electron-installed",
    "security:audit": "node scripts/dependency-security.cjs",
    "security:audit:raw": "pnpm audit --registry=https://registry.npmjs.org --audit-level=high"
  },
  "dependencies": {
    "@infos/avatar-assets": "workspace:*",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "steamworks.js": "0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.12",
    "vue": "^3.5.32",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
    "overrides": {
      "node-abi@>=3.0.0 <3.101.0": "3.101.0",
      "node-abi@>=4.0.0 <4.40.0": "4.40.0",
      "zod@<4.6.6": "^4.6.7",
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "axios@<1.20.0": "^1.20.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "tar@>=6.0.0 <7.5.21": "^7.5.21",
      "proxy-addr@<2.0.8": "^2.0.8",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "brace-expansion@>=1.0.0 <2.0.0": "^1.1.20",
      "brace-expansion@>=2.0.0 <3.0.0": "^2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "form-data@>=2.0.0 <4.0.6": "^4.0.6",
      "glob@>=10.0.0 <10.5.0": "^10.5.0",
      "tmp@<0.2.6": "^0.2.6",
      "browserslist@<4.28.7": "^4.28.7",
      "js-cookie@>=3.0.0 <3.0.7": "^3.0.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "ip-address@<10.3.1": "^10.3.1",
      "follow-redirects@<1.16.1": "^1.16.1",
      "postcss@>=8.0.0 <8.5.18": "^8.5.18",
      "dompurify@>=3.0.0 <3.4.17": "^3.4.17",
      "hono@>=4.0.0 <4.12.25": "^4.12.25",
      "@modelcontextprotocol/sdk@>=1.0.0 <1.32.0": "^1.32.0",
      "@vue/server-renderer@>=3.5.0 <3.5.42": "^3.5.42",
      "vue@>=3.5.0 <3.5.42": "^3.5.42",
      "vite@>=6.0.0 <6.4.4": "^6.4.4",
      "adm-zip@<0.6.1": "^0.6.1",
      "electron-builder@>=26.0.0 <26.15.0": "^26.15.0",
      "app-builder-lib@>=26.0.0 <26.15.0": "^26.15.0",
      "builder-util-runtime@>=9.0.0 <9.7.0": "^9.7.0",
      "drizzle-orm@<0.45.2": "^0.45.2",
      "vite@>=5.0.0 <6.0.0": "^6.4.4",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "vitest@>=4.0.0 <4.1.12": "^4.1.12",
      "@vitest/mocker@>=4.0.0 <4.1.12": "^4.1.12",
      "echarts@>=6.0.0 <6.1.0": "^6.1.0",
      "fflate@<0.8.3": "^0.8.3",
      "file-type@>=21.0.0 <21.3.1": "^21.3.1",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "katex@>=0.16.0 <0.18.2": "^0.18.4",
      "electron-builder-squirrel-windows": "26.15.3",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "postcss-selector-parser@>=6.0.0 <7.1.6": "^7.1.6",
      "uuid@>=8.0.0 <11.1.1": "^11.1.1",
      "esbuild@<0.28.1": "^0.28.1"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.2.0": "patches/http-cache-semantics@4.2.0.patch",
      "file-type@16.5.4": "patches/file-type@16.5.4.patch"
    }
  }
}
