{
  "id": "event-memory",
  "name": "事件记忆",
  "version": "1.0.0",
  "author": "infOS Team",
  "description": "查询与召回由后台整理的长期事件记忆",
  "type": "tool",
  "entry": "index.ts",
  "category": "memory",
  "platforms": [
    "windows",
    "linux",
    "darwin",
    "docker"
  ],
  "tools": [
    {
      "name": "query_event_notes",
      "description": "主动查询自己的长期事件记忆；默认隐藏归档事件。",
      "display": {
        "label": "查询事件",
        "description": "查询长期事件记忆。",
        "icon": "search",
        "color": "orange",
        "style": "search"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "recent",
              "time_range",
              "semantic",
              "same_event",
              "entity",
              "logical",
              "affective",
              "mixed"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "includeArchived": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "maxNodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxReturnTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32000
          },
          "edgeLabels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "temporal_next",
                "temporal_prev",
                "caused_by",
                "same_event",
                "same_topic",
                "involves_person",
                "involves_place",
                "involves_object"
              ]
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "outgoing",
              "incoming",
              "both"
            ]
          }
        }
      }
    }
  ]
}
