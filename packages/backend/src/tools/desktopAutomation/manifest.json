{
  "id": "desktop-automation",
  "name": "桌面自动化",
  "version": "1.0.0",
  "author": "infOS Team",
  "description": "桌面 GUI 自动化操作。通过 DesktopAutomationProvider 适配不同平台。需要桌面环境。",
  "type": "tool",
  "entry": "index.ts",
  "category": "core",
  "platforms": [
    "windows",
    "darwin"
  ],
  "userCopy": {
    "automation_execute": {
      "label": "操作桌面应用",
      "description": "使用鼠标和键盘操作桌面应用。"
    },
    "get_mouse_position": {
      "label": "查看鼠标位置",
      "description": "查看鼠标指针当前所在的位置。"
    },
    "desktop_direct": {
      "label": "剪贴板与媒体键",
      "description": "读写剪贴板、按媒体键、用默认浏览器打开网址。"
    }
  },
  "tools": [
    {
      "name": "automation_execute",
      "description": "依据传了windowId的桌面观察操作（整屏观察不能操作），优先用元素编号ref或控件ID，坐标兜底；动作后等画面稳定再按原视角返回操作后画面。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "自动化动作类型",
            "enum": [
              "invoke",
              "set_value",
              "toggle",
              "select",
              "expand",
              "collapse",
              "click",
              "double_click",
              "triple_click",
              "right_click",
              "move",
              "drag",
              "scroll",
              "type",
              "hotkey",
              "key_down",
              "key_up",
              "mouse_down",
              "mouse_up",
              "notification",
              "wait"
            ]
          },
          "x": {
            "type": "number",
            "description": "截图中的X坐标"
          },
          "y": {
            "type": "number",
            "description": "截图中的Y坐标"
          },
          "x2": {
            "type": "number",
            "description": "拖拽终点X，与起点同一坐标空间"
          },
          "y2": {
            "type": "number",
            "description": "拖拽终点Y，与起点同一坐标空间"
          },
          "coordinateSpace": {
            "type": "string",
            "description": "鼠标坐标空间，默认采用最近截图像素坐标",
            "enum": [
              "normalized",
              "screenshot",
              "desktop"
            ],
            "default": "screenshot"
          },
          "text": {
            "type": "string",
            "description": "输入文字或快捷键（如Ctrl+S、Num0、VolumeUp）；按住的键最多保留2秒"
          },
          "message": {
            "type": "string",
            "description": "通知正文"
          },
          "observationId": {
            "type": "string",
            "description": "最近一次桌面观察返回的ID；通知之外必填"
          },
          "elementId": {
            "type": "string",
            "description": "本次观察中的控件ID；控件操作给它或ref"
          },
          "ref": {
            "type": "integer",
            "minimum": 1,
            "description": "元素图编号，须与同一次观察的observationId同用"
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ],
            "description": "滚动方向"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "滚轮格数，默认3；控件滚动大于1表示翻页"
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ],
            "description": "鼠标键，默认left"
          },
          "modifiers": {
            "type": "string",
            "description": "按住的修饰键，如ctrl+shift"
          },
          "includeElements": {
            "type": "boolean",
            "description": "操作后同时读取可操作控件"
          },
          "expect": {
            "type": "object",
            "description": "预期结果，动作后核对：text出现/gone消失/window窗口出现",
            "properties": {
              "text": {
                "type": "string"
              },
              "gone": {
                "type": "string"
              },
              "window": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 30000,
            "description": "wait毫秒数，默认500最多3000；带until时为上限，默认10000"
          },
          "until": {
            "type": "object",
            "description": "wait直到：window窗口出现（无需observationId）/text出现/gone消失",
            "properties": {
              "window": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "gone": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "settleTimeoutMs": {
            "type": "integer",
            "minimum": 200,
            "maximum": 5000,
            "description": "动作后等画面稳定的上限毫秒数，默认1500"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "get_mouse_position",
      "description": "获取当前鼠标的屏幕坐标。",
      "display": {
        "label": "鼠标位置",
        "icon": "map-pin",
        "color": "purple",
        "style": "desktop"
      },
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "desktop_direct",
      "description": "不用观察、不点界面的直通操作：读写剪贴板、媒体键（播放暂停、切歌、音量）、用系统默认浏览器打开网址；同样经过桌面审批。打开程序用open_application，读写搜索文件用home_files。",
      "display": {
        "label": "直通操作",
        "icon": "desktop",
        "color": "purple",
        "style": "desktop"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "clipboard_read",
              "clipboard_write",
              "media_key",
              "open_url"
            ]
          },
          "text": {
            "type": "string",
            "description": "clipboard_write要放进剪贴板的文字"
          },
          "key": {
            "type": "string",
            "enum": [
              "play_pause",
              "next",
              "previous",
              "stop",
              "volume_up",
              "volume_down",
              "mute"
            ],
            "description": "media_key的按键"
          },
          "times": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "媒体键按几次，默认1（调音量时常用）"
          },
          "url": {
            "type": "string",
            "description": "open_url的网址，只收http/https"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ]
}
