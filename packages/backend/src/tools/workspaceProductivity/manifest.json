{
  "id": "workspace-productivity",
  "name": "workspace_productivity",
  "version": "1.0.0",
  "displayName": "工作区生产力工具",
  "description": "范围读取、Glob 与带版本保护的精确原子编辑",
  "type": "tool",
  "entry": "index.ts",
  "category": "workspace",
  "platforms": ["windows", "linux", "darwin", "docker"],
  "userCopy": {
    "read_file_range": {
      "label": "读取文件片段",
      "description": "只读取文件中的指定部分，适合查看大文件。"
    },
    "glob_files": {
      "label": "按名称查找文件",
      "description": "根据文件名或路径规则批量查找文件。"
    },
    "edit_file": { "label": "编辑文件", "description": "精确修改文件中的一段内容。" }
  },
  "registration": "static",
  "permissions": ["filesystem:read", "filesystem:write"],
  "tools": [
    {
      "name": "read_file_range",
      "description": "按字符、行范围或尾部读取文件，返回 hash 和 read_ref；编辑刚读取的范围时优先用 read_ref，不必重发 old_text。行级单次最多800行。path 也可填 tool-result:ID，配合 offset/limit 分页读取超限工具结果；引用失效后按原始来源读取。",
      "display": { "label": "读取文件", "icon": "file", "color": "sky", "style": "read" },
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "outline": {
            "type": "boolean",
            "description": "按需读取 JS/TS 符号大纲或 Python 声明位置；无需 Python 环境，无法可靠定位时自动返回普通源码"
          },
          "symbol": {
            "type": "string",
            "description": "大纲中的完整限定名；JS/TS 精确定位成功时返回完整符号及版本化 read_ref。Python 或定位失败自动返回源码窗口，必须以实际可见内容和 symbolFallback 提示确定编辑范围"
          },
          "symbol_pick": { "type": "integer", "minimum": 1 },
          "retain_context": {
            "type": "boolean",
            "description": "仅在需要持续比较历史版本时开启，防止该读取随文件更新退出当前执行上下文；仍受总输入容量限制"
          },
          "offset": { "type": "number" },
          "limit": { "type": "number" },
          "line_start": { "type": "number", "minimum": 1, "description": "起始行号，从1开始" },
          "line_end": {
            "type": "number",
            "minimum": 1,
            "description": "结束行号（包含）；省略时默认读取800行，超出800行的请求会截断"
          },
          "tail_lines": {
            "type": "number",
            "minimum": 1,
            "maximum": 800,
            "description": "读取文件尾部行数，最多800行"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "glob_files",
      "description": "在设备文件系统中按 Glob 模式查找文件；相对目录仍以当前工作区为基准",
      "display": { "label": "查找文件", "icon": "search", "color": "purple", "style": "search" },
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "cwd": { "type": "string" },
          "max_depth": { "type": "number" },
          "limit": { "type": "number" },
          "include_hidden": { "type": "boolean" }
        },
        "required": ["pattern"]
      }
    },
    {
      "name": "edit_file",
      "description": "精确编辑单个文件。优先 read_ref+new_text 替换实际读取片段；也支持 path+old_text+new_text 唯一文本替换，或 path+expected_hash+line_start/line_end+new_text 行替换（删除传空字符串）、after_line+new_text 插入（0为文件开头）。steps 批量步骤全部基于同一原始版本，重叠或任一步失败整批不写。多处文本匹配返回 ticketId；再次用 ticket_id+pick 选择，无需重发正文。文件变化后引用失效，必须重读。改用户已有文件、系统和启动位置要确认，系统会等用户应答；被拒绝后不要换路径或换工具重试。",
      "display": { "label": "编辑文件", "icon": "edit", "color": "pink", "style": "edit" },
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "old_text": { "type": "string" },
          "new_text": { "type": "string" },
          "expected_hash": { "type": "string" },
          "retain_context": {
            "type": "boolean",
            "description": "需要持续比较此次写入版本时保留完整调用；通常不填"
          },
          "read_ref": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "after_line": { "type": "integer", "minimum": 0 },
          "ticket_id": { "type": "string" },
          "pick": { "type": "integer", "minimum": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "old_text": { "type": "string" },
                "new_text": { "type": "string" },
                "read_ref": { "type": "string" },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "after_line": { "type": "integer", "minimum": 0 }
              },
              "required": ["new_text"]
            }
          }
        },
        "required": []
      }
    }
  ],
  "compatibility": { "platforms": ["windows", "linux", "darwin", "docker"] }
}
