{
  "id": "finish-task",
  "name": "任务完成",
  "version": "2.0.0",
  "author": "infOS Team",
  "description": "结束当前任务并可选地更新角色状态（情绪、动作、文案等），始终允许调用的生命周期工具",
  "type": "tool",
  "entry": "index.ts",
  "category": "core",
  "platforms": [
    "windows",
    "linux",
    "darwin",
    "docker"
  ],
  "toolDefinition": {
    "name": "finish_task",
    "description": "提交本次执行结果与最终回复。可同时指定接下来休息、等待某人回答或等待已有任务结果，由事件恢复执行。可选状态更新归角色共享。",
    "display": {
      "label": "完成任务",
      "description": "结束当前任务，并把最终结果回复给你。",
      "icon": "check",
      "color": "green",
      "style": "task"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "participation": {
          "type": "object",
          "description": "据点本次参与决定。share 或 question 为当前伙伴登记接话意图，程序按发起、回应与结算阶段安排。回应中的必要追问交还原发起者，独立新话题等待正常空闲机会。answer、acknowledge、close 结算当前回应。可静默提交旁听、专注或休息。",
          "properties": {
            "state": { "type": "string", "enum": ["available", "listening", "conversing", "occupied", "resting"] },
            "purpose": { "type": "string", "enum": ["share", "question", "answer", "acknowledge", "close"] },
            "addressedTo": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
            "exchangeId": { "type": "string" },
            "activityId": { "type": "string" },
            "expectedRevision": { "type": "integer", "minimum": 0 }
          },
          "required": ["state"], "additionalProperties": false
        },
        "next_activity": {
          "type": "object",
          "description": "角色主会话或据点执行结束后的等待意图。据点等待在场伙伴回答时，本次发言自动形成定向请求。等待时释放执行，由真实消息或任务结果恢复。",
          "properties": {
            "kind": { "type": "string", "enum": ["rest", "wait_message", "wait_task"] },
            "senderId": { "type": "string", "description": "等待回答的角色ID，用户使用 user。" },
            "taskId": { "type": "string", "description": "等待的已有后台任务ID。" }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        "ongoing_goals": {
          "type": "string",
          "description": "跨场景持续目标的完整当前记录，留空可清除。"
        },
        "commitments": {
          "type": "string",
          "description": "持续承诺的完整当前记录，留空可清除。"
        },
        "relationships": {
          "type": "string",
          "description": "当前关系状态的完整记录，留空可清除。"
        },
        "spoken_reply": {
          "type": "string",
          "description": "独立的简短口语答复，通常一至两句、不超过一百二十字，不含代码、emoji或装饰符号。TTS只播放此字段，完整交付仍放在reply。"
        },
        "reply": {
          "type": "string",
          "description": "最终回复。主线已经通过 conversation 发表消息时可省略。据点休息可留空，等待回答时提供本次发言，其余执行提供完整交付。"
        },
        "summary": {
          "type": "string",
          "description": "可选：任务完成总结（供任务中心/日志展示），可与 reply 相同。"
        },
        "status": {
          "type": "string",
          "description": "完成状态",
          "enum": [
            "done",
            "partial",
            "failed"
          ]
        },
        "mood": {
          "type": "string",
          "description": "情感底色，例如开心、担心、略有失落。"
        },
        "vibe": {
          "type": "string",
          "description": "外在表现，例如轻松、认真、欲言又止。"
        },
        "mind": {
          "type": "string",
          "description": "简短角色心声，不写任务计划、推理过程或系统信息。"
        },
        "touch_reactions": {
          "type": "object",
          "description": "按触碰部位设置临时随机台词；标准部位为head、arm、body、leg。",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "click_head_msgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "点击头部时的交互消息"
        },
        "click_arm_msgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "点击手臂与手部时的交互消息"
        },
        "click_body_msgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "点击身体时的交互消息"
        },
        "click_leg_msgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "点击腿部与鞋袜时的交互消息"
        },
        "idle_msgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "闲置时的自言自语"
        },
        "back_msgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "主人回来时的欢迎语"
        },
        "task_result": {
          "type": "object",
          "description": "后台持久任务的本段交接。continue 继续，wait 等待时间或任务，deliver 交付，blocked 需要处理，failed 失败。普通聊天不要提供。",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "continue",
                "wait",
                "deliver",
                "blocked",
                "failed"
              ]
            },
            "summary": {
              "type": "string"
            },
            "wakeAt": {
              "type": "string"
            },
            "waitForTaskId": {
              "type": "string"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "toolCallId": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "toolCallId",
                  "description"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "outcome",
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "required": []
    }
  }
}
