{
  "name": "@infos/pictoria",
  "version": "0.9.10",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./client": "./client/src/main.ts"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:standalone": "tsx src/main.ts --standalone --dev-ui",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc -p tsconfig.json && pnpm build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck": "pnpm typecheck:host && pnpm typecheck:client",
    "typecheck:host": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:client": "node ../../../scripts/check-vue-templates.mjs client/src && vue-tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@infos/shared": "workspace:*",
    "@infos/node-sdk": "workspace:*",
    "@infos/node-host": "workspace:*",
    "ajv": "^8.18.0",
    "better-sqlite3": "12.11.1",
    "zod": "^4.6.7",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  }
}
