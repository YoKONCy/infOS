{
  "id": "social",
  "name": "Social Bridge",
  "description": "对外社交平台桥接应用（QQ/Discord 等），管理社交会话、缓冲、调度与回复。独立编译上下文，不依赖主 Agent 的 chat pipeline。",
  "version": "0.9.6",
  "author": "infOS",
  "icon": "icon.png",
  "frontendEntry": "./frontend/index.js",
  "actions": [
    {
      "name": "chat_in_group",
      "description": "读取指定平台群聊的近期上下文，由社交 Agent 单次判断并自然参与聊天。",
      "mode": "command",
      "defaultCommunicationBudget": 8,
      "parameters": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string",
            "description": "目标平台的会话标识"
          },
          "intent": {
            "type": "string",
            "description": "参与意图与边界"
          },
          "platform": {
            "type": "string",
            "description": "目标平台；有多个平台时必须指定"
          },
          "account_id": {
            "type": "string",
            "description": "发送账号；该平台有多个账号时必须指定"
          }
        },
        "required": ["group_id"]
      }
    },
    {
      "name": "get_task",
      "mode": "command",
      "description": "查询持久社交委派的实际执行和交付结果",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": ["task_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "cancel_task",
      "mode": "command",
      "description": "取消持久社交委派",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": ["task_id"],
        "additionalProperties": false
      }
    }
  ],
  "providesTools": [
    {
      "parameters": {
        "properties": {
          "account_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "input": {
            "type": "object"
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "input"]
      },
      "name": "social",
      "description": "日常社交"
    },
    {
      "parameters": {
        "properties": {
          "account_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "input": {
            "type": "object"
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "input"]
      },
      "name": "social_group",
      "description": "群聊事务"
    },
    {
      "parameters": {
        "properties": {
          "account_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "input": {
            "type": "object"
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "input"]
      },
      "name": "social_account",
      "description": "账号与空间"
    }
  ],
  "requiresTools": [
    "web_fetch",
    "query_event_notes",
    "set_reminder",
    "list_reminders",
    "cancel_reminder"
  ],
  "requiredPermissions": [
    {
      "type": "memory.read",
      "description": "读取主 Agent 记忆以理解社交背景与用户偏好",
      "required": true
    },
    {
      "type": "memory.write",
      "description": "提交社交记忆候选（经主 Agent MemoryGate 审核）",
      "required": true
    },
    {
      "type": "network.access",
      "description": "连接 QQ/Discord 等社交平台",
      "required": true
    }
  ],
  "supportedAgentRoles": [],
  "minAiosVersion": "1.0.0",
  "contextRequirements": [
    {
      "type": "persona",
      "required": true,
      "description": "继承主 Agent 人格投影"
    },
    {
      "type": "memory",
      "required": true,
      "description": "社交相关记忆"
    },
    {
      "type": "user_profile",
      "required": false,
      "description": "用户社交偏好"
    }
  ],
  "workspaceMode": "none",
  "checkpointSchema": {
    "fields": [
      {
        "name": "connectedPlatforms",
        "type": "string[]",
        "description": "已连接的平台列表",
        "required": true
      },
      {
        "name": "activeSessions",
        "type": "number",
        "description": "活跃社交会话数",
        "required": true
      },
      {
        "name": "messagesProcessed",
        "type": "number",
        "description": "已处理消息总数",
        "required": true
      }
    ]
  },
  "supportsMultipleSessions": false,
  "defaultSessionPolicy": {
    "tokenBudget": 6000,
    "enableMemoryRetrieval": true,
    "enableToolDescription": true
  }
}
