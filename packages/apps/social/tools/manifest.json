{
  "id": "social-ops",
  "name": "社交平台操作",
  "version": "1.0.0",
  "author": "infOS Team",
  "description": "社交流程工具；三个业务工具的共享契约定义于 @infos/shared/socialTools。",
  "type": "tool",
  "entry": "index.ts",
  "category": "core",
  "platforms": ["windows", "darwin", "linux"],
  "tools": [
    {
      "name": "manage_task",
      "description": "派发后台任务、查询进度与完整结果，或暂停、恢复、取消及处理问答。创建返回任务编号，完成情况以查询结果为准；get 通过 resultOffset/resultLimit 分页读取完整结果。",
      "display": {
        "label": "管理任务",
        "description": "安排后台任务、查看结果，或暂停、恢复、取消任务及处理问答。",
        "icon": "list",
        "color": "purple"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "create 派发（需 instruction）；list 列表；get 详情；update 调整；pause 暂停；resume 继续；cancel 取消；answer 回答；approve 审批；resolve_delivery 核验投递",
            "enum": [
              "create",
              "list",
              "get",
              "update",
              "pause",
              "resume",
              "cancel",
              "answer",
              "approve",
              "resolve_delivery"
            ]
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "除 create/list 外必填，取自创建结果或任务列表的 id"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "description": "除 create/list/get 外必填，取自任务当前 revision"
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "任务指令；create 必填，update 时可用于调整要求"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "可选的任务标题"
          },
          "successCriteria": {
            "type": "string",
            "maxLength": 2000,
            "description": "任务完成时可核对的验收条件"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "description": "补充说明，可用于单题回答、审批理由或恢复时的核验说明"
          },
          "inputId": {
            "type": "string",
            "minLength": 1,
            "description": "answer/approve 必填，使用 get 返回的 request.id"
          },
          "selectedOptionIds": {
            "type": "array",
            "maxItems": 20,
            "description": "answer 的单题选项 ID；多题使用 answers",
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "type": "string",
            "description": "approve 必填：allow_once 同意本次请求，deny_once 拒绝本次请求",
            "enum": ["allow_once", "deny_once"]
          },
          "recovery": {
            "type": "string",
            "description": "任务中断后的恢复方式：默认 confirm 等待核验；仅只读任务可选 read_only 自动继续",
            "enum": ["read_only", "confirm"]
          },
          "confirmUncertain": {
            "type": "boolean",
            "description": "仅在 {{ owner_appellation }} 明确核验结果不明的动作后设为 true"
          },
          "deadline": {
            "type": "string",
            "description": "{{ owner_appellation }} 指定的截止时间，ISO 8601"
          },
          "maxSegments": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "任务分段执行次数上限，默认 48"
          },
          "maxLlmCalls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "任务调用模型的总次数上限，默认 192"
          },
          "maxToolCalls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000,
            "description": "任务调用工具的总次数上限，默认 768"
          },
          "deliveryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250,
            "description": "resolve_delivery 必填，使用 get 返回的 deliveries 中待核验记录的 id"
          },
          "deliveryDecision": {
            "type": "string",
            "description": "仅在 {{ owner_appellation }} 确认已送达或未送达后，标记 sent 或要求 retry",
            "enum": ["sent", "retry"]
          },
          "answers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "description": "answer操作：按题目ID一次提交整组回答。",
            "items": {
              "type": "object",
              "properties": {
                "questionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "当前待回答的问题 ID"
                },
                "selectedOptionIds": {
                  "type": "array",
                  "maxItems": 4,
                  "description": "该题选中的选项 ID，不使用选项时可省略",
                  "items": {
                    "type": "string"
                  }
                },
                "message": {
                  "type": "string",
                  "maxLength": 4000,
                  "description": "该题的文字回答或补充说明"
                }
              },
              "required": ["questionId"],
              "additionalProperties": false
            }
          },
          "resultOffset": {
            "type": "integer",
            "minimum": 0,
            "description": "get 操作的结果字符偏移，默认 0"
          },
          "resultLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32000,
            "description": "get 操作每页结果字符数，默认 12000"
          }
        },
        "required": ["action"],
        "additionalProperties": false
      }
    }
  ]
}
