# syntax=docker/dockerfile:1.7

FROM node:22.23.4-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /build

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/ ./packages/
COPY patches/ ./patches/
COPY scripts/vite-browser-compat.ts ./scripts/vite-browser-compat.ts
COPY scripts/build-daemon-bundle.mjs scripts/collect-daemon-deps.mjs scripts/build-official-apps.mjs scripts/i18n.mjs ./scripts/

RUN pnpm install --frozen-lockfile
RUN node scripts/build-official-apps.mjs && node scripts/build-daemon-bundle.mjs && node scripts/collect-daemon-deps.mjs

FROM node:22.23.4-bookworm-slim AS production

ENV NODE_ENV=production \
    PERO_PORT=9120 \
    PERO_CAPABILITY_PORT=9121 \
    PERO_HOST=0.0.0.0 \
    PERO_DATA_DIR=/app/data \
    PERO_DATABASE_PATH=/app/data/infos.db \
    PERO_APP_ROOT=/app/backend \
    PERO_TEMP_DIR=/app/temp \
    PERO_LOG_LEVEL=3 \
    INFOS_DOCKER=1 \
    INFOS_RESOURCES_ROOT=/app \
    INFOS_APPLICATIONS_ROOT=/app/applications

WORKDIR /app

COPY --from=builder --chown=node:node /build/dist-daemon/daemon.mjs ./backend/daemon.mjs
COPY --from=builder --chown=node:node /build/dist-daemon/recovery.mjs ./backend/recovery.mjs
COPY --from=builder --chown=node:node /build/dist-daemon/social-runtime.mjs ./backend/apps/social/runtime/index.js
COPY --from=builder --chown=node:node /build/dist-daemon/node_modules/ ./node_modules/
COPY --from=builder --chown=node:node /build/dist-daemon/bin/ ./bin/
COPY --from=builder --chown=node:node /build/dist-applications/ ./applications/
COPY --from=builder --chown=node:node /build/packages/backend/src/assets/ ./backend/backend/src/assets/
COPY --from=builder --chown=node:node /build/packages/backend/src/services/mdp/prompts/ ./backend/backend/src/services/mdp/prompts/
COPY --from=builder --chown=node:node /build/packages/backend/src/tools/ ./backend/backend/src/tools/
COPY --from=builder --chown=node:node /build/packages/backend/src/database/migrations/ ./backend/backend/src/database/migrations/
COPY --from=builder --chown=node:node /build/packages/apps/social/ ./backend/apps/social/

RUN mkdir -p /app/data /app/workspaces /app/temp && chown -R node:node /app

USER node

VOLUME ["/app/data", "/app/workspaces"]
EXPOSE 9120 9121

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:9120/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "/app/backend/daemon.mjs"]
