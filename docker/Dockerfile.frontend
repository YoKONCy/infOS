# syntax=docker/dockerfile:1.7

FROM node:22.23.4-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/ ./packages/
COPY patches/ ./patches/
COPY scripts/vite-browser-compat.ts ./scripts/vite-browser-compat.ts
COPY public/ ./public/
COPY scripts/pdfAssetsPlugin.ts ./scripts/pdfAssetsPlugin.ts

RUN pnpm install --frozen-lockfile --filter @infos/frontend...
RUN pnpm --filter @infos/frontend build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS production

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/packages/frontend/dist/ /usr/share/nginx/html/

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/healthz"]

CMD ["nginx", "-g", "daemon off;"]
